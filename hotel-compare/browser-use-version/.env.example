# LLM API (Volcengine Ark CodingPlan, OpenAI-compatible)
# ---------------------------
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_CHAT_MODEL=doubao-seed-2-0-code-preview-260215

# Supabase — Backend / Worker
# ----------------------------
# 服务端 Worker 使用 service_role key 或 anon key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Supabase — Next.js Frontend
# ----------------------------
# 构建静态站点时需要在环境变量中提供（会被打包进前端产物）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
